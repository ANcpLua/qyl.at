{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qyl-at",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-23",
  "routes": [
    {
      "pattern": "qyl.at",
      "custom_domain": true
    }
  ],
  // Must be stated explicitly. `wrangler deploy` PATCHes observability to
  // `{enabled: false}` whenever the key is absent ("if the user hasn't specified
  // observability assume that they want it disabled"), so an omitted block does
  // not mean "leave it alone" — it silently turns Workers Logs off on every CI
  // deploy and reverts any dashboard-side enable. The vitals path logs collector
  // export failures via console.error; without this they go nowhere.
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/_qyl/vitals"]
  },
  "vars": {
    "QYL_OTLP_LOGS_ENDPOINT": "https://api.qyl.at/v1/logs",
    // Default only. Every real deploy overrides this with the commit SHA via
    // `wrangler deploy --var QYL_SERVICE_VERSION:<sha>` (see package.json and
    // .github/workflows/ci.yml), so telemetry can attribute a regression to a
    // deploy. If you ever see service.version="dev" in the collector, something
    // deployed outside those two paths.
    "QYL_SERVICE_VERSION": "dev"
  }
}
