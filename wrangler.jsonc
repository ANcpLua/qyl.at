{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qyl-at",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-23",
  "routes": [
    {
      "pattern": "qyl.at",
      "custom_domain": true
    },
    // One subdomain per design lab direction, matching src/data/variants.ts.
    // worker/index.ts maps each root to /lab/<slug>/.
    { "pattern": "apple-minimal.qyl.at", "custom_domain": true },
    { "pattern": "swiss-grid.qyl.at", "custom_domain": true },
    { "pattern": "editorial.qyl.at", "custom_domain": true },
    { "pattern": "corporate-trust.qyl.at", "custom_domain": true },
    { "pattern": "luxury-serif.qyl.at", "custom_domain": true },
    { "pattern": "neobrutalism.qyl.at", "custom_domain": true },
    { "pattern": "playful-motion.qyl.at", "custom_domain": true },
    { "pattern": "terminal-light.qyl.at", "custom_domain": true },
    { "pattern": "blueprint.qyl.at", "custom_domain": true },
    { "pattern": "bauhaus.qyl.at", "custom_domain": true },
    { "pattern": "zen-ink.qyl.at", "custom_domain": true },
    { "pattern": "lab-notebook.qyl.at", "custom_domain": true },
    { "pattern": "system-classic.qyl.at", "custom_domain": true },
    { "pattern": "risograph.qyl.at", "custom_domain": true },
    { "pattern": "control-room.qyl.at", "custom_domain": true },
    { "pattern": "soft-glass.qyl.at", "custom_domain": true }
  ],
  // Must be stated explicitly. `wrangler deploy` PATCHes observability to
  // `{enabled: false}` whenever the key is absent ("if the user hasn't specified
  // observability assume that they want it disabled"), so an omitted block does
  // not mean "leave it alone" — it silently turns Workers Logs off on every CI
  // deploy and reverts any dashboard-side enable. The vitals path logs collector
  // export failures via console.error; without this they go nowhere.
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/_qyl/vitals", "/"]
  },
  "vars": {
    "QYL_OTLP_LOGS_ENDPOINT": "https://api.qyl.at/v1/logs",
    // Default only. Every real deploy overrides this with the commit SHA via
    // `wrangler deploy --var QYL_SERVICE_VERSION:<sha>` (see package.json and
    // .github/workflows/ci.yml), so telemetry can attribute a regression to a
    // deploy. If you ever see service.version="dev" in the collector, something
    // deployed outside those two paths.
    "QYL_SERVICE_VERSION": "dev"
  }
}
