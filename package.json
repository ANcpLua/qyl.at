{
  "name": "qyl.at",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit && node scripts/check-dependencies.mjs && node scripts/check-versions.mjs",
    "build:site": "astro build && pagefind --site dist && node scripts/finalize-site.mjs",
    "build": "bun run check && bun run build:site",
    "test:unit": "node --test tests/vitals.test.ts",
    "test:gates": "node scripts/check-artifacts.mjs && bun run test:unit && playwright test --project=surface",
    "test:perf": "playwright test --project=performance",
    "test": "bun run build && bun run test:gates",
    "smoke": "bun run test",
    "preview": "wrangler dev",
    "deploy": "bun run test && wrangler deploy --var QYL_SERVICE_VERSION:$(git rev-parse --short HEAD)",
    "deploy:dry": "bun run build && wrangler deploy --dry-run",
    "lint": "oxlint .",
    "check:mcp": "node scripts/check-mcp.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@react-three/fiber": "^9.8.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^13.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.1",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/react": "^7.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "astro": "7.3.1",
    "fontaine": "^0.8.1",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pagefind": "^1.5.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "shadcn": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "wrangler": "^4.129.0"
  }
}
