{
  "name": "qyl.at",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit && node scripts/check-dependencies.mjs && node scripts/check-versions.mjs",
    "build:site": "astro build && pagefind --site dist && node scripts/finalize-site.mjs",
    "build": "bun run check && bun run build:site",
    "test:unit": "node --test tests/vitals.test.ts",
    "test:gates": "node scripts/check-artifacts.mjs && bun run test:unit && playwright test --project=surface",
    "test:perf": "playwright test --project=performance",
    "test": "bun run build && bun run test:gates",
    "smoke": "bun run test",
    "preview": "wrangler dev",
    "deploy": "bun run test && wrangler deploy --var QYL_SERVICE_VERSION:$(git rev-parse --short HEAD)",
    "deploy:dry": "bun run build && wrangler deploy --dry-run",
    "lint": "oxlint .",
    "check:mcp": "node scripts/check-mcp.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@react-three/fiber": "^9.8.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.0.0",
    "motion": "^14.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.1",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "astro": "7.3.5",
    "fontaine": "1.0.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "pagefind": "1.5.2",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "shadcn": "4.21.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "wrangler": "4.147.0"
  }
}
