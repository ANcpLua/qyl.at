---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { docsNavigation } from "../../data/site";
---

<DocsLayout title="Documentation" description="Run the qyl Collector, connect an agent, and understand the protocol and telemetry boundaries.">
  <div class="docs-index-grid">
    {docsNavigation.map((item, index) => (
      <a class="docs-index-card" href={item.href}>
        <span>{String(index + 1).padStart(2, "0")} · GUIDE</span>
        <h2>{item.label}</h2>
        <p>{item.description}</p>
      </a>
    ))}
  </div>
</DocsLayout>
