---
import BaseLayout from "../layouts/BaseLayout.astro";
import { packages, versionOf } from "../data/site";

const questions = [
  ["What is qyl?", "An analytical engine for agents, built and maintained by agents. The NativeAOT Collector ingests OpenTelemetry traces, logs and metrics and computes the answers: triage, failure context, comparisons and fix verification. The MCP server hands those answers to the agent as structured results. qyl has no dashboard or other interface for people."],
  ["What does qyl store?", "The Collector retains OTLP traces, logs and metrics in DuckDB for 30 days by default, plus the annotations, saved queries and failure status agents create through the write tools. Profiles are not supported."],
  ["How does an agent connect?", "Install the qyl plugin in Claude Code from the ancplua-anthropic marketplace or in Codex from the ancplua-openai marketplace, or add https://mcp.qyl.at/mcp as a connector in ChatGPT. All three reach the same hosted endpoint. Locally, npx qyl-mcp-server --stdio connects an agent to a Collector started with qyl up."],
  ["Do I need the hosted endpoint?", "No. qyl up runs the Collector on your machine and the stdio server reads it without an account. The hosted endpoint reads the Collector project your account is authorized for on api.qyl.at."],
  ["Which MCP revisions does the server answer?", "Protocol 2026-07-28, through the MCP TypeScript SDK v2. The SDK's stateless fallback also answers 2025-era clients that open with initialize, with the same tools and checks."],
  ["Can a tool change my telemetry?", "No. The read tools are annotated read-only. The write tools change only annotations, saved queries and failure status: create_annotation and create_saved_query are marked as non-destructive writes, and update_annotation, update_saved_query, update_failure_status and delete_record as destructive, so a host can ask before each call. The server still requires qyl:write or qyl:delete for them."],
  ["What happens when the Collector is unavailable?", "The call fails with a typed error that names a stable code and whether a retry can succeed. qyl never substitutes demonstration data for collector evidence."],
  ["How is the hosted endpoint authenticated?", "qyl is an OAuth 2.1 Resource Server backed by Auth0. The MCP client performs Authorization Code with PKCE for https://mcp.qyl.at/mcp. qyl:read is required on every request; the write tools also need qyl:write (create, update) or qyl:delete (delete_record), and a call without it gets an insufficient_scope challenge to reconnect and allow that scope."],
  ["Can qyl notify an agent?", "Yes, through MCP Events on the hosted endpoint. A client that implements them, such as ChatGPT, subscribes to trace.error, optionally for one service, and receives a signed webhook for each new trace with an error span in its project."],
  ["Which versions does this site describe?", `${packages.map((entry) => `${entry.name} ${entry.version}`).join(", ")}. The footer of every page states them, and the getting-started table links each version to the registry that serves it.`],
  ["Where do the telemetry attribute names come from?", "One Weaver registry holding the upstream OpenTelemetry conventions, the gen-ai conventions and qyl’s own attributes as YAML. Weaver templates emit C# and TypeScript constants from the same resolved registry, with generated outputs committed and checked for drift. qyl-owned instrumentation uses those constants; the Collector applies the rename table generated from the same registry and counts every dropped attribute on qyl.collector.attributes.dropped."],
  ["Is there a Qyl.Api.Sdk without Native AOT?", `No. Qyl.Api.Sdk ${versionOf("Qyl.Api.Sdk")} is an MSBuild SDK for a Native AOT ASP.NET Core API. AddQylApi registers validation, problem details and the OpenAPI document in one call, and XML output is generated at compile time behind [GenerateXml] rather than reflected at runtime.`],
] as const;
---

<BaseLayout title="FAQ" description="Direct answers about what qyl is, how agents connect, what it stores, protocol support, safety, Events and hosted authentication.">
  <section class="page-hero">
    <div class="site-shell">
      <span class="eyebrow">FAQ</span>
      <h1 class="page-title">Questions worth answering precisely.</h1>
      <p class="lede">No roadmap theatre. These answers describe the software that exists now.</p>
    </div>
  </section>
  <section class="editorial-section">
    <div class="site-shell faq-layout">
      <div><span class="eyebrow">Current release</span><h2 class="section-title">The operating model, without the brochure.</h2></div>
      <div class="faq-list">
        {questions.map(([question, answer], index) => (
          <details open={index === 0}>
            <summary><span class="faq-number">Q{index + 1}</span><span>{question}</span><span class="faq-toggle" aria-hidden="true"></span></summary>
            <div class="faq-answer"><p>{answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
