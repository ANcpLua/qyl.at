---
import BaseLayout from "../layouts/BaseLayout.astro";
import { releaseWave, versionOf } from "../data/site";

const questions = [
  ["What does qyl store?", "The collector retains OTLP traces, logs and metrics in DuckDB. Profiles are not supported."],
  ["Do I need the hosted MCP server?", "No. qyl up runs the collector and embedded dashboard locally. qyl.mcp also runs a loopback workbench for connecting to local or remote MCP servers."],
  ["What is the difference between qyl and qyl.mcp?", "qyl owns telemetry ingestion, storage, the product read API, and the collector dashboard. qyl.mcp owns MCP runtime behavior, the workbench, local MCP process supervision, and MCP Apps."],
  ["Does the workbench fall back to old MCP revisions?", "No. User-configured stdio and Streamable HTTP connections pin 2026-07-28 and fail when the peer cannot negotiate it. The built-in server uses an internal legacy-only in-memory transport that is not user configurable or network facing."],
  ["Can an MCP tool run without confirmation?", "Only when its annotations consistently mark it read-only, non-destructive, and closed-world. Missing or contradictory safety hints require review of the exact call."],
  ["Does live mode invent demo data when the collector is unavailable?", "No. Collector failures remain errors. Generated telemetry is available only with the explicit QYL_DEMO=1 setting and every demo result is labelled."],
  ["How is the hosted endpoint authenticated?", "qyl is an OAuth 2.1 Resource Server backed by Auth0. The MCP client performs Authorization Code with PKCE for https://mcp.qyl.at/mcp. qyl:read is the only required scope."],
  ["Which versions does this site describe?", `The ${releaseWave} wave: qyl ${versionOf("qyl")}, Qyl.Api.Sdk ${versionOf("Qyl.Api.Sdk")}, Qyl.Telemetry.AutoInstrumentation and Qyl.Telemetry.Hosting ${versionOf("Qyl.Telemetry.AutoInstrumentation")}, the three Qyl.Telemetry.SemanticConventions ids at ${versionOf("Qyl.Telemetry.SemanticConventions")}, Qyl.Api.Contracts and @ancplua/qyl-api-schema ${versionOf("Qyl.Api.Contracts")}, and qyl-mcp-server ${versionOf("qyl-mcp-server")}. Every page carries the wave in its footer, and the getting-started table links each version to the feed that serves it.`],
  ["Where do the telemetry attribute names come from?", "One Weaver registry holding the upstream OpenTelemetry conventions, the gen-ai conventions and qyl\u2019s own attributes as YAML. Weaver templates emit the C# constants, which are committed. The instrumentation writes only those constants and never renames anything; the collector applies the rename table generated from the same registry and counts every dropped attribute on qyl.collector.attributes.dropped."],
  ["Is there a Qyl.Api.Sdk without Native AOT?", `No. Qyl.Api.Sdk ${versionOf("Qyl.Api.Sdk")} is an MSBuild SDK for a Native AOT ASP.NET Core API. AddQylApi registers validation, problem details and the OpenAPI document in one call, and XML output is generated at compile time behind [GenerateXml] rather than reflected at runtime.`],
] as const;
---

<BaseLayout title="FAQ" description="Direct answers about qyl storage, local operation, MCP protocol support, safety, demo data, and hosted authentication.">
  <section class="page-hero">
    <div class="site-shell">
      <span class="eyebrow">FAQ</span>
      <h1 class="page-title">Questions worth answering precisely.</h1>
      <p class="lede">No roadmap theatre. These answers describe the software that exists now.</p>
    </div>
  </section>
  <section class="editorial-section">
    <div class="site-shell faq-layout">
      <div><span class="eyebrow">Current release</span><h2 class="section-title">The operating model, without the brochure.</h2></div>
      <div class="faq-list">
        {questions.map(([question, answer], index) => (
          <details open={index === 0}>
            <summary><span class="faq-number">Q{index + 1}</span><span>{question}</span><span class="faq-toggle" aria-hidden="true"></span></summary>
            <div class="faq-answer"><p>{answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
