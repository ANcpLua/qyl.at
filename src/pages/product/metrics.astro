---
import ProductPage from "../../components/ProductPage.astro";
---

<ProductPage
  title="Metrics"
  eyebrow="Product · metrics"
  intro="Original OTLP measurements, or explicit aggregation over a bounded time range."
  heading="Original points and explicit aggregation."
  description="Metric identity includes the resource, instrumentation scope and descriptor. Original points preserve exact integers, explicit and exponential histograms, summaries and exemplars. Aggregate queries disclose their numeric representation; incompatible descriptors and contradictory observations remain visible, and an unsupported aggregation returns a diagnostic instead of a number."
  tools={["list_metrics", "get_metric_series", "query_metric"]}
  capabilities={[
    { name: "OTLP /v1/metrics", description: "Ingest binary protobuf or OTLP JSON over HTTP, plus the official OTLP gRPC service." },
  ]}
  command={`qyl up
# point an OTLP exporter at http://127.0.0.1:4318`}
/>
