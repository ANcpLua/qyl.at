---
import VariantLayout from "../../layouts/VariantLayout.astro";
import { variants } from "../../data/variants";
const count = variants.length;
---
<VariantLayout title={`${count} directions — qyl design lab`} preview={false}>
  <div class="min-h-screen bg-[#f8f8f6] font-sans text-zinc-900">
    <header class="border-b border-zinc-200 bg-white">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5" aria-label="Design lab navigation">
        <a href="/" class="text-xl font-semibold tracking-tighter">qyl<span class="font-normal text-zinc-500"> / design lab</span></a>
        <a href="/docs/" class="text-sm text-zinc-600 hover:text-zinc-950">Product documentation ↗</a>
      </nav>
    </header>
    <main class="mx-auto max-w-7xl px-6 pb-20 pt-14 sm:pt-20">
      <div class="grid gap-8 border-b border-zinc-200 pb-12 md:grid-cols-[1.4fr_1fr] md:items-end">
        <div><p class="mb-5 font-mono text-xs uppercase tracking-[.16em] text-zinc-500">React Bits Pro / Interface study 01</p><h1 class="text-5xl font-medium leading-[1.02] tracking-[-.055em] sm:text-7xl">One product.<br /><span class="text-zinc-500">{count} directions.</span></h1></div>
        <div class="max-w-md"><p class="text-lg leading-relaxed text-zinc-600">{count} complete interpretations of qyl. Every one light, responsive, and built with Tailwind. Open a direction and explore the whole page.</p><p class="mt-5 text-sm text-zinc-500">8 React Bits Pro design skills · {count - 8} original directions · one subdomain each</p></div>
      </div>
      <a href="/lab/effects/" class="mt-7 flex min-h-20 flex-wrap items-center justify-between gap-3 rounded-xl border border-blue-200 bg-blue-50 px-6 py-5 text-blue-950 transition-colors hover:bg-blue-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-700"><span><span class="block font-mono text-[10px] uppercase tracking-[.15em] text-blue-700">New / React Bits Pro</span><span class="mt-1 block text-xl font-medium tracking-tight">Step into the third dimension.</span></span><span class="text-sm">Explore all seven effects ↗</span></a>
      <div class="flex flex-wrap items-center gap-2 py-7" role="group" aria-label="Filter design directions">
        {['All', 'Minimal', 'Structured', 'Expressive'].map(filter => <button type="button" data-filter={filter} aria-pressed={filter === 'All'} class="min-h-10 rounded-full border border-zinc-300 px-4 text-sm text-zinc-700 hover:border-zinc-800 aria-pressed:border-zinc-950 aria-pressed:bg-zinc-950 aria-pressed:text-white">{filter}</button>)}
        <span id="design-count" class="ml-auto text-xs text-zinc-500" aria-live="polite">{count} directions</span>
      </div>
      <div class="grid gap-x-7 gap-y-10 md:grid-cols-2" id="design-grid">
        {variants.map((variant, index) => <article data-category={variant.tag}>
          <a href={`/lab/${variant.slug}/`} class="group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900">
            <div class="aspect-[16/10] overflow-hidden rounded-lg border border-zinc-200 bg-white"><img src={`/lab-previews/${variant.slug}.png`} width="1280" height="800" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" alt={`${variant.name}: ${variant.summary}`} class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.015] motion-reduce:transition-none" /></div>
            <div class="mt-5 flex items-center gap-3"><span class={`h-2.5 w-2.5 rounded-full ${variant.accent}`} aria-hidden="true"></span><span class="font-mono text-xs text-zinc-500">{String(index + 1).padStart(2, "0")}</span><h2 class="text-xl font-medium tracking-tight">{variant.name}</h2><span class="ml-auto text-zinc-500" aria-hidden="true">↗</span></div>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600">{variant.summary}</p><p class="mt-1 font-mono text-xs text-zinc-500">{variant.slug}.qyl.at</p>
          </a>
        </article>)}
      </div>
      <section class="mt-16 border-t border-zinc-200 pt-10"><h2 class="text-2xl font-medium tracking-tight">See two directions together.</h2><p class="mt-2 text-sm text-zinc-600">Choose a pair. Compare the page previews, then open either direction to explore its links and controls.</p><div class="mt-5 grid gap-6 lg:grid-cols-2">{['left','right'].map((side,index) => <div><label for={`compare-${side}`} class="mb-2 block text-xs font-medium uppercase tracking-wider text-zinc-500">{index === 0 ? 'First direction' : 'Second direction'}</label><select id={`compare-${side}`} data-compare={side} class="mb-4 min-h-11 w-full rounded-md border border-zinc-300 bg-white px-3 text-sm">{variants.map((variant,i) => <option value={variant.slug} selected={i === index}>{variant.name}</option>)}</select><a id={`compare-link-${side}`} href={`/lab/${variants[index].slug}/`} class="block overflow-hidden rounded-lg border border-zinc-300 bg-white"><img id={`compare-image-${side}`} src={`/lab-previews/${variants[index].slug}.png`} alt={`${variants[index].name} preview, open full page`} width="1280" height="800" loading="lazy" class="aspect-[16/10] w-full object-cover object-top" /></a></div>)}</div></section>
      <footer class="mt-16 flex flex-wrap justify-between gap-4 border-t border-zinc-200 pt-6 text-xs text-zinc-500"><p>qyl / React Bits Pro design study</p><a href="https://github.com/ANcpLua/monte-carlo-ui-lab" class="hover:text-zinc-900">Inspired by Monte Carlo UI Lab ↗</a></footer>
    </main>
  </div>
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      let count = 0;
      document.querySelectorAll('[data-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      document.querySelectorAll<HTMLElement>('[data-category]').forEach(card => { card.hidden = filter !== 'All' && card.dataset.category !== filter; if (!card.hidden) count++; });
      const status = document.querySelector('#design-count'); if (status) status.textContent = `${count} directions`;
    }));
    document.querySelectorAll<HTMLSelectElement>('[data-compare]').forEach(select => select.addEventListener('change', () => {
      const link = document.querySelector<HTMLAnchorElement>(`#compare-link-${select.dataset.compare}`);
      const image = document.querySelector<HTMLImageElement>(`#compare-image-${select.dataset.compare}`);
      if (link) link.href = `/lab/${select.value}/`;
      if (image) { image.src = `/lab-previews/${select.value}.png`; image.alt = `${select.selectedOptions[0].text} preview, open full page`; }
    }));
  </script>
</VariantLayout>
