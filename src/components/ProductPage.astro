---
import BaseLayout from "../layouts/BaseLayout.astro";
import { productNavigation } from "../data/site";
import { mcpTools } from "../data/mcp-tools";

type ToolName = (typeof mcpTools)[number]["name"];

interface Capability {
  name: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  intro: string;
  heading: string;
  /** MCP tools, described by their own registered descriptions. */
  tools: ToolName[];
  /** Everything that is not an MCP tool: wire endpoints, attributes, headers. */
  capabilities: Capability[];
  command: string;
}

const { title, description, eyebrow, intro, heading, tools, capabilities, command } = Astro.props;
const pathname = Astro.url.pathname;
const listed = [
  ...tools.map((name) => {
    const tool = mcpTools.find((candidate) => candidate.name === name);
    if (tool === undefined) throw new Error(`${pathname}: no MCP tool named ${name}`);
    return { name: tool.name, description: tool.description };
  }),
  ...capabilities,
];
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="site-shell">
      <span class="eyebrow">{eyebrow}</span>
      <h1 class="page-title">{title}</h1>
      <p class="lede">{intro}</p>
    </div>
  </section>
  <section class="editorial-section">
    <div class="site-shell product-layout">
      <aside class="product-index">
        <p>Product</p>
        <nav aria-label="Product navigation">
          {productNavigation.map((item) => <a href={item.href} aria-current={pathname === item.href ? "page" : undefined}>{item.label}</a>)}
        </nav>
      </aside>
      <article class="product-copy">
        <h2>{heading}</h2>
        <p>{description}</p>
        <div class="capability-list">
          {listed.map((capability) => (
            <div class="capability"><code>{capability.name}</code><p>{capability.description}</p></div>
          ))}
        </div>
        <pre class="code-card"><code>{command}</code></pre>
      </article>
    </div>
  </section>
</BaseLayout>
