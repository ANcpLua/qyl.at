---
// The published versions, rendered from src/data/site.ts so this table and the
// footer cannot disagree. Every row links to the registry that serves it: the
// site states a version, the registry proves it.
import { packages } from "../data/site";
---

<table class="release-table">
  <caption>Every version below is published; each row links to its registry.</caption>
  <thead>
    <tr><th scope="col">Package</th><th scope="col">Version</th><th scope="col">What it is</th></tr>
  </thead>
  <tbody>
    {packages.map((entry) => (
      <tr>
        <th scope="row"><a href={entry.registry}><code>{entry.name}</code></a></th>
        <td>{entry.version}</td>
        <td>{entry.summary}</td>
      </tr>
    ))}
  </tbody>
</table>
